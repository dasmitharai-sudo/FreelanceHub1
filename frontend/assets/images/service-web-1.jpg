<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="sgrad_WebDevelopment" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5" />
      <stop offset="100%" stop-color="#1E1B4B" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" rx="16" fill="url(#sgrad_WebDevelopment)"/>
  <g opacity="0.1">
    <circle cx="100" cy="100" r="250" fill="#ffffff"/>
    <circle cx="700" cy="400" r="200" fill="#ffffff"/>
    <rect x="300" y="-50" width="300" height="300" rx="40" transform="rotate(45 450 100)" fill="#ffffff"/>
  </g>
  <!-- Content -->
  <g transform="translate(60, 80)">
    <rect width="180" height="42" rx="21" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.4)"/>
    <text x="90" y="27" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" font-weight="700" fill="#ffffff" text-anchor="middle">WEB DEVELOPMENT</text>
    
    <text x="0" y="160" font-family="'Plus Jakarta Sans', sans-serif" font-size="44" font-weight="800" fill="#ffffff" width="680">
      Modern Full-Stack Web App
    </text>
    <text x="0" y="220" font-family="'Inter', sans-serif" font-size="22" font-weight="400" fill="rgba(255,255,255,0.85)">
      Verified FreelanceHub Pro Talent • Direct Purchase
    </text>
    
    <g transform="translate(0, 270)">
      <rect width="170" height="50" rx="25" fill="#ffffff"/>
      <text x="85" y="32" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" font-weight="700" fill="#1E1B4B" text-anchor="middle">Order Now</text>
    </g>
  </g>
</svg>